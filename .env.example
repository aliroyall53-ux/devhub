# Database
DATABASE_URL=postgresql://devhub:devhub_password@postgres:5432/devhub_db
SQLALCHEMY_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH

# Backend
API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
SECRET_KEY=your_secret_key_change_in_production
ENCRYPTION_KEY=your_encryption_key_change_in_production

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# AI Provider (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Payment Provider
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Environment
ENVIRONMENT=development
DEBUG=True

# Security - SSRF Protection
ALLOWED_DOMAINS=example.com,test.com
BLOCKED_IPS=127.0.0.1,0.0.0.0,169.254.169.254
BLOCKED_PORTS=25,587,465

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Background Jobs
WORKER_POOL_SIZE=4
TASK_TIMEOUT=300

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
